{
  "name": "codelens-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "node ../analyzer/node_modules/eslint/bin/eslint.js src --config eslint.config.mjs",
    "format:check": "prettier --check src vite.config.ts index.html"
  },
  "dependencies": {
    "lucide-react": "0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "^29.1.1",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
