# Generate independent values with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CODELENS_ADMIN_TOKEN=replace-with-a-random-token-at-least-32-characters
CODELENS_WEBHOOK_SECRET=replace-with-another-random-secret
CODELENS_DATABASE_URL=sqlite:///./codelens.db
CODELENS_REDIS_URL=redis://localhost:6379/0
CODELENS_GITHUB_APP_ID=
CODELENS_GITHUB_PRIVATE_KEY_PATH=
# Exact comma-separated repository names; required for live webhooks
CODELENS_ALLOWED_REPOSITORIES=
# Optional; evidence-only AI explanations, never source code
CODELENS_AI_ENABLED=false
CODELENS_AI_KEY=
CODELENS_AI_MODEL=gpt-4.1-mini
